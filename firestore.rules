rules_version = '2';

// All reads and writes go through the trusted API (/api), which uses the
// Firebase Admin SDK and validates every request. Admin SDK access is not
// affected by these rules. Browsers get no direct database access, so
// prices, stock, orders and invoices cannot be changed by editing requests.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
