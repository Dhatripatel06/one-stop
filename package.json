{
  "name": "oss-digital-catalog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ONE STOP SOLUTION (OSS) catalogue, inventory, orders and billing",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "emulators": "firebase emulators:start --only firestore,auth,storage --project demo-oss",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "firebase emulators:exec --only firestore,auth,storage --project demo-oss \"node --test --test-concurrency=1 tests/integration/*.test.js\"",
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed:emulator": "node scripts/migrate.mjs --seed-legacy --apply && node scripts/emulator-users.mjs",
    "test:browser": "python tests/browser/e2e.py"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "pdfkit": "^0.17.2"
  }
}
