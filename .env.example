# =========================================================
# OSS — server environment variables (Vercel → Project → Settings → Environment Variables)
# Placeholders only. Never commit real values. Never prefix these for browser use.
# =========================================================

# Firebase project
FIREBASE_PROJECT_ID=oss-digital-catalog
FIREBASE_STORAGE_BUCKET=oss-digital-catalog.firebasestorage.app

# Service account (Firebase console → Project settings → Service accounts → Generate new private key)
# Option A: whole JSON file, raw or base64-encoded
FIREBASE_SERVICE_ACCOUNT=
# Option B: individual fields (keep the \n sequences in the key)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@oss-digital-catalog.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated Firebase Auth UIDs that are always owners (bootstrap access).
# The existing admin account's UID from the old admin.html was NBaVvM86X9SqffFiWI7lA27Isnl1 — confirm before use.
ADMIN_UIDS=

# Random secret (32+ characters) used to sign expiring invoice download links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVOICE_LINK_SECRET=

# Public site address used in invoice links, e.g. https://oss-vert.vercel.app
PUBLIC_SITE_URL=

# Optional: Firebase web config (public values; defaults match the existing project)
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_WEB_APP_ID=

# Optional: website order submissions allowed per IP per 10 minutes (default 8)
# ORDER_RATE_LIMIT=8

# ---------------------------------------------------------
# Local development only (npm run dev sets these automatically
# unless USE_EMULATORS=0)
# ---------------------------------------------------------
# USE_EMULATORS=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
