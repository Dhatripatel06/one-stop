# =========================================================
# OSS — server environment variables
# Local: copy to .env.local (git-ignored). Vercel: Project → Settings → Environment Variables.
# Placeholders only. Never commit real values. Nothing here may be exposed to the browser.
# =========================================================

# ---- Firebase (Firestore + Authentication) -----------------
# Live project: one-stop-72ee5 (alias "development" in .firebaserc)
FIREBASE_PROJECT_ID=one-stop-72ee5
# Optional: "live" or "emulator". If set, the server refuses to start when the
# environment disagrees (it never silently switches between emulator and live).
# FIREBASE_MODE=live

# Service account (Firebase console → Project settings → Service accounts → Generate new private key)
# Option A: the whole JSON file, raw or base64-encoded
FIREBASE_SERVICE_ACCOUNT=
# Option B: individual fields (keep the \n sequences in the key)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@one-stop-72ee5.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Option C (local live development): GOOGLE_APPLICATION_CREDENTIALS=path to a key file

# Web app config for admin sign-in (Firebase console → Project settings → Your apps → Web app).
# These identify the project and are public by design, but they must be registered first.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# FIREBASE_AUTH_DOMAIN=one-stop-72ee5.firebaseapp.com

# Comma-separated Firebase Auth UIDs that are always owners (bootstrap access).
ADMIN_UIDS=

# ---- Cloudinary (all product images) -----------------------
# Cloudinary console → Settings → API keys. The API secret stays on the server:
# browsers only ever receive a short-lived signature for one upload.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternative to the three variables above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Folder for new uploads (default oss/products)
# CLOUDINARY_FOLDER=oss/products

# ---- Invoices and site -------------------------------------
# Random secret (32+ characters) used to sign expiring invoice download links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVOICE_LINK_SECRET=
# Public site address used in invoice links, e.g. https://oss-vert.vercel.app
PUBLIC_SITE_URL=
# Website order submissions allowed per IP per 10 minutes (default 8)
# ORDER_RATE_LIMIT=8

# ---- Local development only --------------------------------
# `npm run dev` forces emulator mode with a demo-* project ID, whatever is above.
# `npm run dev:live` uses the live values above and prints a warning.
# EMULATOR_PROJECT_ID=demo-oss
